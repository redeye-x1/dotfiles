# SSH Keys - ignore all keys (public and private)
.ssh/id_*
.ssh/*_rsa
.ssh/*_ed25519
.ssh/*_ecdsa
.ssh/*.pub
.ssh/known_hosts*

# Allow config only
!.ssh/config

# Machine-specific directory shortcuts
.config/directories

# macOS
.DS_Store

# Vim
*.swp
*.swo
*~

# Temporary files
*.tmp
*.bak

# Editor/Tool configs (generated/cache)
.config/github-copilot/

# Node modules (should be installed, not tracked)
node_modules/
bun.lock
package-lock.json
yarn.lock
.config/raycast/

# Runtime state that tools write next to their config
.config/browser-harness/
.config/herdr/*.log
.config/herdr/session.json
.config/herdr/release-notes.json
.config/herdr/.plugins.lock
# Generated by Orca, which rewrites it on every sync
.config/opencode/

# Secrets: local .env backups and the Proton Pass agent token/session
.config/env-backups/
.config/proton-pass-agent/
