Include ~/.ssh/conductor_config

# SSH Config Template
# Customize this file for your own hosts and servers

# ===========================================
# Global Settings (applies to all hosts)
# ===========================================

# Automatically add keys to ssh-agent
AddKeysToAgent yes

# Keep connections alive
ServerAliveInterval 60
ServerAliveCountMax 3

# Reuse connections for speed (multiplexing)
ControlMaster auto
ControlPath ~/.ssh/sockets/%r@%h-%p
ControlPersist 600


# ===========================================
# Example: Personal GitHub
# ===========================================
# Host github.com
#   HostName github.com
#   User git
#   IdentityFile ~/.ssh/id_ed25519_github
#   IdentitiesOnly yes


# ===========================================
# Example: Work GitHub (using alias)
# ===========================================
# Host github-work
#   HostName github.com
#   User git
#   IdentityFile ~/.ssh/id_ed25519_work_github
#   IdentitiesOnly yes
#
# Usage: git clone git@github-work:company/repo.git


# ===========================================
# Example: Personal Server
# ===========================================
# Host myserver
#   HostName 192.168.1.100
#   User yourusername
#   IdentityFile ~/.ssh/id_ed25519_myserver
#   IdentitiesOnly yes
#   Port 22


# ===========================================
# Example: Jump/Bastion Host
# ===========================================
# Host production-server
#   HostName 10.0.1.100
#   User admin
#   IdentityFile ~/.ssh/id_ed25519_production
#   ProxyJump bastion.company.com
#   IdentitiesOnly yes


# ===========================================
# Example: Wildcard Pattern
# ===========================================
# Host *.company.com
#   User admin
#   IdentityFile ~/.ssh/id_ed25519_company
#   IdentitiesOnly yes


# ===========================================
# Add Your Own Hosts Below
# ===========================================
# Private keys live in ~/.ssh (gitignored); IdentityFile names them.

